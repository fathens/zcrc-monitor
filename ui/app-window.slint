import { Button } from "std-widgets.slint";
import { SlintConfigEntry, SlintKeyDefinition, SlintEvaluationPeriod, SlintTokenHolding, SlintPortfolioHolding, SlintChartZone, SlintYLabel, SlintChartPoint, SlintXLabel } from "types.slint";
import { SettingsTab } from "settings-tab.slint";
import { PortfolioTab } from "portfolio-tab.slint";

export { SlintConfigEntry, SlintKeyDefinition, SlintEvaluationPeriod, SlintTokenHolding, SlintPortfolioHolding, SlintChartZone, SlintYLabel, SlintChartPoint, SlintXLabel }

export component AppWindow inherits Window {
    title: "zcrc-monitor";
    default-font-family: "Noto Sans CJK JP";
    preferred-width: 360px;
    preferred-height: 800px;
    min-width: 320px;

    in property <string> health-status: "disconnected";
    in property <string> health-status-text: "未接続";
    in property <string> health-db-status: "";
    in property <string> health-error-message: "";

    // Settings properties
    in-out property <string> config-instance-id <=> settings.config-instance-id;
    in property <[SlintConfigEntry]> config-entries <=> settings.config-entries;
    in property <string> config-error-message <=> settings.config-error-message;
    in property <string> config-status-message <=> settings.config-status-message;
    in property <bool> config-loaded <=> settings.config-loaded;
    in-out property <int> config-editing-index <=> settings.config-editing-index;
    in-out property <string> config-edit-value <=> settings.config-edit-value;
    in-out property <string> config-new-key <=> settings.config-new-key;
    in-out property <string> config-new-value <=> settings.config-new-value;

    in property <[SlintKeyDefinition]> key-definitions <=> settings.key-definitions;
    in property <string> key-definitions-error <=> settings.key-definitions-error;
    in-out property <bool> key-definitions-expanded <=> settings.key-definitions-expanded;

    // Portfolio properties
    in property <[SlintEvaluationPeriod]> eval-periods <=> portfolio.eval-periods;
    in property <string> eval-periods-error <=> portfolio.eval-periods-error;
    in property <bool> eval-periods-loaded <=> portfolio.eval-periods-loaded;
    in-out property <int> eval-period-selected-index <=> portfolio.eval-period-selected-index;
    in-out property <int> eval-periods-page <=> portfolio.eval-periods-page;
    in property <int> eval-periods-total-count <=> portfolio.eval-periods-total-count;
    in-out property <int> eval-periods-page-size <=> portfolio.eval-periods-page-size;

    in property <[SlintPortfolioHolding]> eval-period-holdings <=> portfolio.eval-period-holdings;
    in property <string> eval-period-holdings-error <=> portfolio.eval-period-holdings-error;
    in property <bool> eval-period-holdings-loaded <=> portfolio.eval-period-holdings-loaded;

    in property <[SlintYLabel]> eval-periods-y-labels <=> portfolio.eval-periods-y-labels;
    in property <string> eval-periods-line-path <=> portfolio.eval-periods-line-path;
    in property <[SlintChartPoint]> eval-periods-points <=> portfolio.eval-periods-points;
    in property <[SlintXLabel]> eval-periods-x-labels <=> portfolio.eval-periods-x-labels;
    in property <int> eval-periods-chart-width <=> portfolio.eval-periods-chart-width;
    in property <image> line-chart-image <=> portfolio.line-chart-image;
    in property <image> bar-chart-image <=> portfolio.bar-chart-image;
    in property <[SlintYLabel]> line-chart-y-labels <=> portfolio.line-chart-y-labels;
    in property <[SlintYLabel]> bar-chart-y-labels <=> portfolio.bar-chart-y-labels;
    in-out property <int> chart-mode <=> portfolio.chart-mode;
    in property <[SlintChartZone]> chart-zones <=> portfolio.chart-zones;
    in property <string> eval-period-selected-initial-value <=> portfolio.eval-period-selected-initial-value;

    in-out property <bool> settings-visible: false;

    // Callbacks
    callback config-refresh <=> settings.config-refresh;
    callback config-select-entry <=> settings.config-select-entry;
    callback config-upsert <=> settings.config-upsert;
    callback config-delete <=> settings.config-delete;
    callback config-cancel-edit <=> settings.config-cancel-edit;

    callback eval-periods-refresh <=> portfolio.eval-periods-refresh;
    callback eval-period-select <=> portfolio.eval-period-select;
    callback eval-periods-next-page <=> portfolio.eval-periods-next-page;
    callback eval-periods-prev-page <=> portfolio.eval-periods-prev-page;
    callback eval-period-chart-click <=> portfolio.eval-period-chart-click;
    callback eval-period-viewport-changed <=> portfolio.eval-period-viewport-changed;
    callback holdings-chart-size-changed <=> portfolio.holdings-chart-size-changed;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        // === Header ===
        HorizontalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                horizontal-stretch: 1;

                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.health-status == "healthy" ? #4caf50
                        : root.health-status == "unhealthy" ? #f44336
                        : #9e9e9e;
                }

                Text {
                    text: root.health-status-text;
                    vertical-alignment: center;
                }
            }

            Button {
                text: root.settings-visible ? "x 閉じる" : "設定";
                min-width: 80px;
                min-height: 48px;
                clicked => {
                    root.settings-visible = !root.settings-visible;
                }
            }
        }

        if root.health-db-status != "" : Text {
            text: "DB: " + root.health-db-status;
        }

        if root.health-error-message != "" : Text {
            text: root.health-error-message;
            color: #f44336;
        }

        // === Settings panel / Portfolio (切り替え) ===
        Rectangle {
            vertical-stretch: 1;

            settings := SettingsTab {
                visible: root.settings-visible;
                width: parent.width;
                height: parent.height;
            }

            portfolio := PortfolioTab {
                visible: !root.settings-visible;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
