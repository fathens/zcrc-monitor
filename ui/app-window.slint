import { Button, LineEdit, ListView, TabWidget } from "std-widgets.slint";

export struct SlintConfigEntry {
    key: string,
    value: string,
    instance-id: string,
}

export struct SlintKeyDefinition {
    key: string,
    description: string,
    type-name: string,
    resolved-value: string,
}

export struct SlintEvaluationPeriod {
    id: int,
    period-id: string,
    start-time: string,
    initial-value: string,
    selected-tokens: string,
}

export struct SlintTokenHolding {
    token: string,
    balance: string,
    value-wnear: string,
}

export struct SlintPortfolioHolding {
    timestamp: string,
    token-holdings: [SlintTokenHolding],
    total-value-wnear: string,
}

export component AppWindow inherits Window {
    title: "zcrc-monitor";
    preferred-width: 800px;
    preferred-height: 600px;

    in property <string> health-status: "disconnected";
    in property <string> health-status-text: "未接続";
    in property <string> health-db-status: "";
    in property <string> health-error-message: "";

    in-out property <string> config-instance-id: "*";
    in property <[SlintConfigEntry]> config-entries: [];
    in property <string> config-error-message: "";
    in property <string> config-status-message: "";
    in property <bool> config-loaded: false;
    in-out property <int> config-editing-index: -1;
    in-out property <string> config-edit-value: "";
    in-out property <string> config-new-key: "";
    in-out property <string> config-new-value: "";

    in property <[SlintKeyDefinition]> key-definitions: [];
    in property <string> key-definitions-error: "";
    in-out property <bool> key-definitions-expanded: false;

    in property <[SlintEvaluationPeriod]> eval-periods: [];
    in property <string> eval-periods-error: "";
    in property <bool> eval-periods-loaded: false;
    in-out property <int> eval-period-selected-index: -1;
    in-out property <int> eval-periods-page: 0;
    in property <int> eval-periods-total-count: 0;
    in-out property <int> eval-periods-page-size: 20;

    in property <[SlintPortfolioHolding]> eval-period-holdings: [];
    in property <string> eval-period-holdings-error: "";
    in property <bool> eval-period-holdings-loaded: false;

    in property <image> line-chart-image;
    in property <image> bar-chart-image;
    in-out property <int> chart-mode: 0; // 0=全体推移, 1=トークン別

    callback config-refresh();
    callback config-select-entry(/* index */ int);
    callback config-upsert(/* key */ string, /* value */ string);
    callback config-delete(/* key */ string);
    callback config-cancel-edit();

    callback eval-periods-refresh();
    callback eval-period-select(/* index */ int);
    callback eval-periods-next-page();
    callback eval-periods-prev-page();

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        // === Health Status (global, above tabs) ===
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.health-status == "healthy" ? #4caf50
                    : root.health-status == "unhealthy" ? #f44336
                    : #9e9e9e;
            }

            Text {
                text: root.health-status-text;
                vertical-alignment: center;
            }
        }

        if root.health-db-status != "" : Text {
            text: "DB: " + root.health-db-status;
        }

        if root.health-error-message != "" : Text {
            text: root.health-error-message;
            color: #f44336;
        }

        // === Tab Widget ===
        TabWidget {
            vertical-stretch: 1;

            // ===== Tab 1: 設定 =====
            Tab {
                title: "設定";

                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;

                    Text {
                        text: "設定管理";
                        font-size: 16px;
                        font-weight: 700;
                    }

                    // Instance ID input + buttons
                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "インスタンスID:";
                            vertical-alignment: center;
                        }

                        config-id-input := LineEdit {
                            text: root.config-instance-id;
                            placeholder-text: "インスタンスIDを入力";
                            horizontal-stretch: 1;
                            edited(value) => {
                                root.config-instance-id = value;
                            }
                        }

                        Button {
                            text: "読込";
                            clicked => { root.config-refresh(); }
                        }
                    }

                    if root.config-error-message != "" : Text {
                        text: root.config-error-message;
                        color: #f44336;
                    }

                    if root.config-status-message != "" : Text {
                        text: root.config-status-message;
                        color: #4caf50;
                    }

                    // Config entries list
                    if root.config-instance-id == "" : Text {
                        text: "インスタンスIDを入力してください";
                        color: #9e9e9e;
                        horizontal-alignment: center;
                    }

                    if root.config-instance-id != "" && root.config-loaded && root.config-entries.length == 0 : Text {
                        text: "設定エントリがありません";
                        color: #9e9e9e;
                        horizontal-alignment: center;
                    }

                    if root.config-entries.length > 0 : ListView {
                        vertical-stretch: 1;

                        for entry[index] in root.config-entries : Rectangle {
                            background: root.config-editing-index == index ? #e8f0fe
                                : touch.has-hover ? #e3f2fd
                                : transparent;

                            touch := TouchArea {
                                clicked => {
                                    if root.config-editing-index != index {
                                        root.config-select-entry(index);
                                    }
                                }
                            }

                            if root.config-editing-index != index : HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 16px;

                                Text {
                                    text: entry.key;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    font-weight: 500;
                                }

                                Text {
                                    text: entry.value;
                                    vertical-alignment: center;
                                    horizontal-stretch: 2;
                                    color: #555555;
                                }
                            }

                            if root.config-editing-index == index : HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;

                                Text {
                                    text: entry.key;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    font-weight: 500;
                                }

                                LineEdit {
                                    text: root.config-edit-value;
                                    placeholder-text: "値";
                                    horizontal-stretch: 2;
                                    edited(value) => {
                                        root.config-edit-value = value;
                                    }
                                }

                                Button {
                                    text: "保存";
                                    clicked => {
                                        root.config-upsert(entry.key, root.config-edit-value);
                                    }
                                }

                                Button {
                                    text: "削除";
                                    clicked => {
                                        root.config-delete(entry.key);
                                    }
                                }

                                Button {
                                    text: "戻す";
                                    clicked => {
                                        root.config-cancel-edit();
                                    }
                                }
                            }
                        }
                    }

                    // New entry form
                    Rectangle {
                        height: 1px;
                        background: #eeeeee;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "キー:";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: root.config-new-key;
                            placeholder-text: "キー";
                            horizontal-stretch: 1;
                            edited(value) => {
                                root.config-new-key = value;
                            }
                        }

                        Text {
                            text: "値:";
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text: root.config-new-value;
                            placeholder-text: "値";
                            horizontal-stretch: 2;
                            edited(value) => {
                                root.config-new-value = value;
                            }
                        }

                        Button {
                            text: "追加";
                            clicked => {
                                root.config-upsert(root.config-new-key, root.config-new-value);
                            }
                        }
                    }

                    // === Key Definitions Reference ===
                    Rectangle {
                        height: 1px;
                        background: #cccccc;
                    }

                    ref-toggle := TouchArea {
                        clicked => {
                            root.key-definitions-expanded = !root.key-definitions-expanded;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: root.key-definitions-expanded ? "▼" : "▶";
                                vertical-alignment: center;
                            }

                            Text {
                                text: "キー定義リファレンス (" + root.key-definitions.length + "件)";
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.key-definitions-error != "" : Text {
                        text: root.key-definitions-error;
                        color: #f44336;
                    }

                    if !root.key-definitions-expanded : Rectangle {
                        vertical-stretch: 1;
                    }

                    if root.key-definitions-expanded && root.key-definitions.length > 0 : ListView {
                        vertical-stretch: 1;

                        for def[index] in root.key-definitions : Rectangle {
                            background: def-hover.has-hover ? #e3f2fd
                                : Math.mod(index, 2) == 0 ? #f8f8f8
                                : transparent;

                            def-hover := TouchArea {}

                            VerticalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: def.key;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: def.resolved-value;
                                        color: #1976d2;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        width: root.width * 0.25;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;

                                    Text {
                                        text: def.type-name;
                                        color: #888888;
                                        font-size: 11px;
                                    }

                                    Text {
                                        text: "—";
                                        color: #cccccc;
                                        font-size: 11px;
                                    }

                                    Text {
                                        text: def.description;
                                        color: #666666;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ===== Tab 2: ポートフォリオ =====
            Tab {
                title: "ポートフォリオ";

                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;

                    Text {
                        text: "評価期間";
                        font-size: 16px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Button {
                            text: "更新";
                            clicked => { root.eval-periods-refresh(); }
                        }

                        if root.eval-periods-loaded : Text {
                            text: "全 " + root.eval-periods-total-count + " 件";
                            vertical-alignment: center;
                            color: #888888;
                        }
                    }

                    if root.eval-periods-error != "" : Text {
                        text: root.eval-periods-error;
                        color: #f44336;
                    }

                    if root.eval-periods-loaded && root.eval-periods.length == 0 : Text {
                        text: "評価期間がありません";
                        color: #9e9e9e;
                        horizontal-alignment: center;
                    }

                    if root.eval-periods.length > 0 : ListView {
                        vertical-stretch: 1;

                        for ep[index] in root.eval-periods : Rectangle {
                            background: root.eval-period-selected-index == index ? #e8f0fe
                                : ep-touch.has-hover ? #e3f2fd
                                : Math.mod(index, 2) == 0 ? #f8f8f8
                                : transparent;

                            ep-touch := TouchArea {
                                clicked => {
                                    root.eval-period-select(index);
                                }
                            }

                            VerticalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: 16px;

                                    Text {
                                        text: ep.period-id;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: ep.start-time;
                                        color: #555555;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: ep.initial-value;
                                        color: #1976d2;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.eval-period-selected-index == index : Text {
                                    text: "トークン: " + ep.selected-tokens;
                                    color: #666666;
                                    font-size: 11px;
                                }
                            }
                        }
                    }

                    // Pagination controls
                    if root.eval-periods-loaded : HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Button {
                            text: "前へ";
                            enabled: root.eval-periods-page > 0;
                            clicked => { root.eval-periods-prev-page(); }
                        }

                        Text {
                            text: "ページ " + (root.eval-periods-page + 1);
                            vertical-alignment: center;
                        }

                        Button {
                            text: "次へ";
                            enabled: (root.eval-periods-page + 1) * root.eval-periods-page-size < root.eval-periods-total-count;
                            clicked => { root.eval-periods-next-page(); }
                        }
                    }

                    // === Charts ===
                    if root.line-chart-image.width > 0 || root.bar-chart-image.width > 0 : Rectangle {
                        height: 1px;
                        background: #cccccc;
                    }

                    if root.line-chart-image.width > 0 || root.bar-chart-image.width > 0 : HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Button {
                            text: root.chart-mode == 0 ? "[全体推移]" : "全体推移";
                            clicked => { root.chart-mode = 0; }
                        }

                        Button {
                            text: root.chart-mode == 1 ? "[トークン別]" : "トークン別";
                            clicked => { root.chart-mode = 1; }
                        }
                    }

                    if root.chart-mode == 0 && root.line-chart-image.width > 0 : Image {
                        source: root.line-chart-image;
                        height: 280px;
                        image-fit: contain;
                    }

                    if root.chart-mode == 1 && root.bar-chart-image.width > 0 : Image {
                        source: root.bar-chart-image;
                        height: 280px;
                        image-fit: contain;
                    }

                    // === Holdings Table ===
                    if root.eval-period-holdings-error != "" : Text {
                        text: root.eval-period-holdings-error;
                        color: #f44336;
                    }

                    if root.eval-period-holdings-loaded && root.eval-period-holdings.length == 0 : Text {
                        text: "ホールディングデータなし";
                        color: #9e9e9e;
                        horizontal-alignment: center;
                    }

                    if root.eval-period-holdings.length > 0 : ListView {
                        vertical-stretch: 1;

                        for holding in root.eval-period-holdings : VerticalLayout {
                            spacing: 2px;

                            Rectangle {
                                height: 1px;
                                background: #e0e0e0;
                            }

                            Text {
                                text: holding.timestamp;
                                font-size: 11px;
                                font-weight: 500;
                                color: #333333;
                            }

                            for th in holding.token-holdings : HorizontalLayout {
                                padding-left: 16px;
                                spacing: 12px;

                                Text {
                                    text: th.token;
                                    font-size: 11px;
                                    color: #555555;
                                    horizontal-stretch: 2;
                                    overflow: elide;
                                }

                                Text {
                                    text: th.balance;
                                    font-size: 11px;
                                    color: #666666;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                }

                                Text {
                                    text: th.value-wnear;
                                    font-size: 11px;
                                    color: #1976d2;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                spacing: 12px;

                                Text {
                                    text: "合計";
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: #333333;
                                    horizontal-stretch: 2;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: holding.total-value-wnear;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: #1976d2;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
