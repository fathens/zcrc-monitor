import { Button, ListView } from "std-widgets.slint";
import { SlintEvaluationPeriod, SlintPortfolioHolding, SlintChartZone, SlintYLabel } from "types.slint";

export component PortfolioTab inherits VerticalLayout {
    padding: 8px;
    spacing: 8px;

    in property <[SlintEvaluationPeriod]> eval-periods: [];
    in property <string> eval-periods-error: "";
    in property <bool> eval-periods-loaded: false;
    in-out property <int> eval-period-selected-index: -1;
    in-out property <int> eval-periods-page: 0;
    in property <int> eval-periods-total-count: 0;
    in-out property <int> eval-periods-page-size: 20;

    in property <[SlintPortfolioHolding]> eval-period-holdings: [];
    in property <string> eval-period-holdings-error: "";
    in property <bool> eval-period-holdings-loaded: false;

    in property <[SlintYLabel]> eval-periods-y-labels: [];
    in property <image> eval-periods-chart-body-image;
    in property <int> eval-periods-chart-width: 0;
    in property <image> line-chart-image;
    in property <image> bar-chart-image;
    in property <[SlintYLabel]> line-chart-y-labels: [];
    in property <[SlintYLabel]> bar-chart-y-labels: [];
    in-out property <int> chart-mode: 0; // 0=全体推移, 1=トークン別
    in property <[SlintChartZone]> chart-zones: [];
    in property <string> eval-period-selected-initial-value: "";

    callback eval-periods-refresh();
    callback eval-period-select(/* index */ int);
    callback eval-periods-next-page();
    callback eval-periods-prev-page();
    callback eval-period-chart-click(/* x_px */ float);
    callback eval-period-viewport-changed(/* viewport_x */ float, /* visible_width */ float);

    // スクロール停止検出用プロパティ
    property <float> prev-eval-viewport-x: 0;
    property <float> settled-eval-viewport-x: 0;

    // === 評価期間チャート（横スクロール、Y軸動的） ===
    HorizontalLayout {
        spacing: 4px;
        alignment: start;

        Text {
            text: "評価期間";
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Button {
            text: "更新";
            clicked => { root.eval-periods-refresh(); }
        }
    }

    if root.eval-periods-error != "" : Text {
        text: root.eval-periods-error;
        color: #f44336;
    }

    if root.eval-periods-chart-width > 0 : Rectangle {
        height: 150px;

        // スクロール停止を検出して Y 軸を更新するデバウンスタイマー
        // viewport-x が変化すると running=true、300ms 後に安定を確認して発火
        eval-settle-timer := Timer {
            interval: 300ms;
            running: (-eval-flick.viewport-x / 1px) != root.settled-eval-viewport-x;
            triggered => {
                if (-eval-flick.viewport-x / 1px) == root.prev-eval-viewport-x {
                    // 前回チェック時から変化なし → スクロール停止
                    root.settled-eval-viewport-x = root.prev-eval-viewport-x;
                    root.eval-period-viewport-changed(root.settled-eval-viewport-x, eval-flick.width / 1px);
                }
                root.prev-eval-viewport-x = -eval-flick.viewport-x / 1px;
            }
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 65px;
            height: 150px;

            for label in root.eval-periods-y-labels : Text {
                text: label.text;
                y: label.y-pos * 1px - 7px;
                animate y { duration: 300ms; easing: ease-in-out; }
                width: 60px;
                horizontal-alignment: right;
                font-size: 12px;
                color: #333333;
            }
        }

        eval-flick := Flickable {
            x: 65px;
            y: 0;
            width: parent.width - 65px;
            height: 150px;
            viewport-width: root.eval-periods-chart-width * 1px;
            viewport-height: 150px;

            Image {
                source: root.eval-periods-chart-body-image;
                width: root.eval-periods-chart-width * 1px;
                height: 150px;
                image-fit: fill;
            }

            // ホバーゾーンハイライト（リアクティブ：mouse-x でゾーン自動判定）
            for zone in root.chart-zones : Rectangle {
                x: zone.start * 1px;
                y: 0;
                width: (zone.end - zone.start) * 1px;
                height: 150px;
                background: chart-body-ta.has-hover
                    && chart-body-ta.mouse-x >= zone.start * 1px
                    && chart-body-ta.mouse-x < zone.end * 1px
                    ? #1976d220 : transparent;
            }

            chart-body-ta := TouchArea {
                width: root.eval-periods-chart-width * 1px;
                height: 150px;
                mouse-cursor: pointer;

                clicked => {
                    root.eval-period-chart-click(chart-body-ta.pressed-x / 1px);
                }
            }
        }
    }

    // === Loading indicator ===
    if root.eval-period-selected-index >= 0 && !root.eval-period-holdings-loaded && root.eval-period-holdings-error == "" : Text {
        text: "読み込み中...";
        color: #9e9e9e;
        horizontal-alignment: center;
        font-size: 14px;
    }

    // === 初期投資額 ===
    if root.eval-period-selected-index >= 0 && root.eval-period-selected-initial-value != "" : Text {
        text: "初期投資: " + root.eval-period-selected-initial-value;
        font-size: 14px;
        font-weight: 500;
        color: #333333;
    }

    // === Holdings Charts ===
    if root.eval-period-holdings-loaded && root.eval-period-holdings.length > 0 : Rectangle {
        height: 1px;
        background: #cccccc;
    }

    if root.eval-period-holdings-loaded && root.eval-period-holdings.length > 0 : HorizontalLayout {
        spacing: 8px;
        alignment: start;

        Button {
            text: root.chart-mode == 0 ? "[全体推移]" : "全体推移";
            clicked => { root.chart-mode = 0; }
        }

        Button {
            text: root.chart-mode == 1 ? "[トークン別]" : "トークン別";
            clicked => { root.chart-mode = 1; }
        }
    }

    if root.chart-mode == 0 && root.eval-period-holdings-loaded && root.eval-period-holdings.length > 0 : HorizontalLayout {
        height: 200px;

        Rectangle {
            width: 70px;

            for label in root.line-chart-y-labels : Text {
                text: label.text;
                y: label.y-pos * 1px - 7px;
                animate y { duration: 300ms; easing: ease-in-out; }
                width: 65px;
                horizontal-alignment: right;
                font-size: 12px;
                color: #333333;
            }
        }

        Image {
            source: root.line-chart-image;
            horizontal-stretch: 1;
            image-fit: contain;
        }
    }

    if root.chart-mode == 1 && root.eval-period-holdings-loaded && root.eval-period-holdings.length > 0 : HorizontalLayout {
        height: 200px;

        Rectangle {
            width: 70px;

            for label in root.bar-chart-y-labels : Text {
                text: label.text;
                y: label.y-pos * 1px - 7px;
                animate y { duration: 300ms; easing: ease-in-out; }
                width: 65px;
                horizontal-alignment: right;
                font-size: 12px;
                color: #333333;
            }
        }

        Image {
            source: root.bar-chart-image;
            horizontal-stretch: 1;
            image-fit: contain;
        }
    }

    // === Holdings Table ===
    if root.eval-period-holdings-error != "" : Text {
        text: root.eval-period-holdings-error;
        color: #f44336;
    }

    if root.eval-period-holdings-loaded && root.eval-period-holdings.length == 0 : Text {
        text: "ホールディングデータなし";
        color: #9e9e9e;
        horizontal-alignment: center;
    }

    // 下部スペーサー（holdings がない場合に上部要素が引き伸ばされるのを防止）
    if root.eval-period-holdings.length == 0 : Rectangle {
        vertical-stretch: 1;
    }

    if root.eval-period-holdings.length > 0 : ListView {
        vertical-stretch: 1;

        for holding in root.eval-period-holdings : VerticalLayout {
            spacing: 4px;

            Rectangle {
                height: 1px;
                background: #e0e0e0;
            }

            Text {
                text: holding.timestamp;
                font-size: 13px;
                font-weight: 500;
                color: #333333;
            }

            for th in holding.token-holdings : HorizontalLayout {
                padding-left: 16px;
                spacing: 12px;

                Text {
                    text: th.token;
                    font-size: 13px;
                    color: #555555;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: th.balance;
                    font-size: 13px;
                    color: #666666;
                    min-width: 150px;
                    horizontal-alignment: right;
                }

                Text {
                    text: th.value-wnear;
                    font-size: 13px;
                    color: #1976d2;
                    min-width: 100px;
                    horizontal-alignment: right;
                }
            }

            HorizontalLayout {
                padding-left: 16px;
                spacing: 12px;

                Text {
                    text: "合計";
                    font-size: 13px;
                    font-weight: 500;
                    color: #333333;
                    horizontal-stretch: 2;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: holding.total-value-wnear;
                    font-size: 13px;
                    font-weight: 500;
                    color: #1976d2;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                }
            }
        }
    }
}
