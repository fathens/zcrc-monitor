import { Button, ListView } from "std-widgets.slint";
import { SlintEvaluationPeriod, SlintPortfolioHolding } from "types.slint";

export component PortfolioTab inherits VerticalLayout {
    padding: 8px;
    spacing: 8px;

    in property <[SlintEvaluationPeriod]> eval-periods: [];
    in property <string> eval-periods-error: "";
    in property <bool> eval-periods-loaded: false;
    in-out property <int> eval-period-selected-index: -1;
    in-out property <int> eval-periods-page: 0;
    in property <int> eval-periods-total-count: 0;
    in-out property <int> eval-periods-page-size: 20;

    in property <[SlintPortfolioHolding]> eval-period-holdings: [];
    in property <string> eval-period-holdings-error: "";
    in property <bool> eval-period-holdings-loaded: false;

    in property <image> line-chart-image;
    in property <image> bar-chart-image;
    in-out property <int> chart-mode: 0; // 0=全体推移, 1=トークン別

    callback eval-periods-refresh();
    callback eval-period-select(/* index */ int);
    callback eval-periods-next-page();
    callback eval-periods-prev-page();

    Text {
        text: "評価期間";
        font-size: 16px;
        font-weight: 700;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        Button {
            text: "更新";
            clicked => { root.eval-periods-refresh(); }
        }

        if root.eval-periods-loaded : Text {
            text: "全 " + root.eval-periods-total-count + " 件";
            vertical-alignment: center;
            color: #888888;
        }
    }

    if root.eval-periods-error != "" : Text {
        text: root.eval-periods-error;
        color: #f44336;
    }

    if root.eval-periods-loaded && root.eval-periods.length == 0 : Text {
        text: "評価期間がありません";
        color: #9e9e9e;
        horizontal-alignment: center;
    }

    if root.eval-periods.length > 0 : ListView {
        vertical-stretch: 1;

        for ep[index] in root.eval-periods : Rectangle {
            background: root.eval-period-selected-index == index ? #e8f0fe
                : ep-touch.has-hover ? #e3f2fd
                : Math.mod(index, 2) == 0 ? #f8f8f8
                : transparent;

            ep-touch := TouchArea {
                clicked => {
                    root.eval-period-select(index);
                }
            }

            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 16px;

                    Text {
                        text: ep.period-id;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        text: ep.start-time;
                        color: #555555;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: ep.initial-value;
                        color: #1976d2;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                if root.eval-period-selected-index == index : Text {
                    text: "トークン: " + ep.selected-tokens;
                    color: #666666;
                    font-size: 11px;
                }
            }
        }
    }

    // Pagination controls
    if root.eval-periods-loaded : HorizontalLayout {
        spacing: 8px;
        alignment: center;

        Button {
            text: "前へ";
            enabled: root.eval-periods-page > 0;
            clicked => { root.eval-periods-prev-page(); }
        }

        Text {
            text: "ページ " + (root.eval-periods-page + 1);
            vertical-alignment: center;
        }

        Button {
            text: "次へ";
            enabled: (root.eval-periods-page + 1) * root.eval-periods-page-size < root.eval-periods-total-count;
            clicked => { root.eval-periods-next-page(); }
        }
    }

    // === Charts ===
    if root.line-chart-image.width > 0 || root.bar-chart-image.width > 0 : Rectangle {
        height: 1px;
        background: #cccccc;
    }

    if root.line-chart-image.width > 0 || root.bar-chart-image.width > 0 : HorizontalLayout {
        spacing: 8px;
        alignment: start;

        Button {
            text: root.chart-mode == 0 ? "[全体推移]" : "全体推移";
            clicked => { root.chart-mode = 0; }
        }

        Button {
            text: root.chart-mode == 1 ? "[トークン別]" : "トークン別";
            clicked => { root.chart-mode = 1; }
        }
    }

    if root.chart-mode == 0 && root.line-chart-image.width > 0 : Image {
        source: root.line-chart-image;
        height: 280px;
        image-fit: contain;
    }

    if root.chart-mode == 1 && root.bar-chart-image.width > 0 : Image {
        source: root.bar-chart-image;
        height: 280px;
        image-fit: contain;
    }

    // === Holdings Table ===
    if root.eval-period-holdings-error != "" : Text {
        text: root.eval-period-holdings-error;
        color: #f44336;
    }

    if root.eval-period-holdings-loaded && root.eval-period-holdings.length == 0 : Text {
        text: "ホールディングデータなし";
        color: #9e9e9e;
        horizontal-alignment: center;
    }

    if root.eval-period-holdings.length > 0 : ListView {
        vertical-stretch: 1;

        for holding in root.eval-period-holdings : VerticalLayout {
            spacing: 2px;

            Rectangle {
                height: 1px;
                background: #e0e0e0;
            }

            Text {
                text: holding.timestamp;
                font-size: 11px;
                font-weight: 500;
                color: #333333;
            }

            for th in holding.token-holdings : HorizontalLayout {
                padding-left: 16px;
                spacing: 12px;

                Text {
                    text: th.token;
                    font-size: 11px;
                    color: #555555;
                    horizontal-stretch: 2;
                    overflow: elide;
                }

                Text {
                    text: th.balance;
                    font-size: 11px;
                    color: #666666;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                }

                Text {
                    text: th.value-wnear;
                    font-size: 11px;
                    color: #1976d2;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                }
            }

            HorizontalLayout {
                padding-left: 16px;
                spacing: 12px;

                Text {
                    text: "合計";
                    font-size: 11px;
                    font-weight: 500;
                    color: #333333;
                    horizontal-stretch: 2;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: holding.total-value-wnear;
                    font-size: 11px;
                    font-weight: 500;
                    color: #1976d2;
                    horizontal-stretch: 1;
                    horizontal-alignment: right;
                }
            }
        }
    }
}
